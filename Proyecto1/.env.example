# ==============================================================================
# Variables de entorno - Proyecto 1 (SG-Food)
# Copiar este archivo a .env y definir contraseñas seguras.
# ==============================================================================

# Data Warehouse (PostgreSQL)
DW_DB=sgfood_dw
DW_USER=dw_user
DW_PASSWORD=cambiar_dw_pass
DW_PORT=5433

# BD transaccional fuente (PostgreSQL)
SRC_DB=sgfood_src
SRC_USER=src_user
SRC_PASSWORD=cambiar_src_pass
SRC_PORT=5434

# Base de metadatos de Airflow (PostgreSQL)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiar_airflow_db_pass

# Acceso a la interfaz web de Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_admin_pass
AIRFLOW_PORT=8080

# Identificador de usuario para permisos en Linux/Docker
AIRFLOW_UID=50000
